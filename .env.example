# Copy this file to .env and fill it in. Never commit .env.

# PostgreSQL connection string.
#   Local:  postgres://USER:PASSWORD@localhost:5432/butts_kitchen
#   Neon:   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The kitchen dashboard PIN. Change it.
ADMIN_PIN=1234

# Any long random string. Keeps kitchen sign-ins valid across restarts.
SESSION_SECRET=

# Time zone used for "today" and "this month" in the sales figures
TZ=Asia/Karachi

PORT=3000
