{
  "name": "butts-kitchen",
  "version": "1.0.0",
  "description": "Ordering site and live kitchen dashboard for Butts Kitchen",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "db:clear-orders": "node --env-file-if-exists=.env scripts/clear-orders.js",
    "build:server": "node scripts/build-server.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
